# ==============================================================================
# ARGON 4 // HERMES EDITION — Configuración Completa (Fases 0 a 6)
# Copia esta plantilla en .env y completa las integraciones que utilices.
# Los campos vacíos desactivan las integraciones opcionales.
# ==============================================================================

# --- 1. Identidad, Idioma y Servidor Local ---
AGENT_NAME=Argon 4
LANGUAGE_CODE=es-PE
HUD_PORT=8000

# --- 2. Perfil de Voz Neuronal (Edge TTS) ---
ASSISTANT_VOICE=es-ES-AlvaroNeural
VOICE_PITCH=-14Hz
VOICE_RATE=+6%
VOICE_VOLUME=1.0

# --- 3. Modo de Operación y Privacidad Local-First (Fase 2) ---
# Valores aceptados para ARGON_MODE: local_first | strict_local | cloud_first
ARGON_MODE=local_first
LOCAL_PROVIDER=ollama
CLOUD_PROVIDER=gemini
# Valores aceptados para CLOUD_FALLBACK: manual_approval | auto | disabled
CLOUD_FALLBACK=manual_approval
# Impide enviar capturas, portapapeles o código local a la nube sin permiso
ALLOW_CLOUD_SENSITIVE_DATA=false

# --- 4. Políticas de Seguridad y Ciclo Agéntico (Fases 1 y 3) ---
REQUIRE_CONFIRMATION=true
TOOL_TIMEOUT_SECONDS=30
MAX_PLAN_STEPS=5
MAX_PARALLEL_TOOLS=3
MAX_PLAN_DURATION_SECONDS=45.0

# --- 5. Proveedor Local Principal (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=45

# --- 6. Proveedor en la Nube Opcional (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 7. Integración con Notion API ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- 8. Correo Electrónico (IMAP) ---
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- 9. Puente de WhatsApp y VoIP ---
DEFAULT_COUNTRY_CODE=+51
DEFAULT_TARGET_PHONE=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_SESSION=argon_session
SIP_SOFTPHONE_BIN=linphonecsh